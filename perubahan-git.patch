+   "metadata": {},
+   "source": [
+    "### air_data.py"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "bac1c3f7",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "(work / 'air_data.py').write_text(r'''\"\"\"Hourly UCI observations, chronological partitions and train-only transforms.\"\"\"\n",
+    "from hashlib import sha256\n",
+    "from io import BytesIO\n",
+    "from pathlib import Path\n",
+    "from urllib.request import urlopen\n",
+    "from zipfile import ZipFile\n",
+    "\n",
+    "import numpy as np\n",
+    "import pandas as pd\n",
+    "\n",
+    "UCI_URL = \"https://archive.ics.uci.edu/static/public/360/air+quality.zip\"\n",
+    "UCI_CSV_SHA256 = \"13277ae5d8581e80b7be09d47c7d3d06fe9b8e957078f2cf6e859f955e62f996\"\n",
+    "TARGET = \"CO(GT)\"\n",
+    "FEATURES = [\"PT08.S1(CO)\", \"PT08.S2(NMHC)\", \"PT08.S3(NOx)\", \"PT08.S4(NO2)\",\n",
+    "            \"PT08.S5(O3)\", \"T\", \"RH\", \"AH\"]\n",
+    "MIN_STEPS, MAX_STEPS = 4, 8\n",
+    "\n",
+    "\n",
+    "def official_csv(cache):\n",
+    "    path = Path(cache)\n",
+    "    if path.exists():\n",
+    "        csv = path.read_bytes()\n",
+    "    else:\n",
+    "        with urlopen(UCI_URL, timeout=60) as response, ZipFile(BytesIO(response.read())) as archive:\n",
+    "            csv = archive.read(\"AirQualityUCI.csv\")\n",
+    "        if sha256(csv).hexdigest() == UCI_CSV_SHA256:\n",
+    "            path.parent.mkdir(parents=True, exist_ok=True)\n",
+    "            path.write_bytes(csv)\n",
+    "    if sha256(csv).hexdigest() != UCI_CSV_SHA256:\n",
+    "        raise ValueError(\"Berkas cache berbeda dari CSV UCI untuk eksperimen ini.\")\n",
+    "    return csv\n",
+    "\n",
+    "\n",
+    "def numbers(series):\n",
+    "    text = series.astype(\"string\").str.strip().replace(\"\", pd.NA).str.replace(\",\", \".\", regex=False)\n",
+    "    values = pd.to_numeric(text, errors=\"coerce\").astype(float)\n",
+    "    if (text.notna() & values.isna()).any() or np.isinf(values).any():\n",
+    "        raise ValueError(f\"Kolom {series.name} berisi angka yang tidak valid.\")\n",
+    "    return values.replace(-200, np.nan)\n",
+    "\n",
+    "\n",
+    "def read_data(file, required, require_contiguous=True):\n",
+    "    \"\"\"Accept the original UCI CSV or an ISO timestamp CSV, including forecast-only inputs.\"\"\"\n",
+    "    data = file if isinstance(file, pd.DataFrame) else pd.read_csv(\n",
+    "        file, sep=None, engine=\"python\", dtype=str, encoding=\"utf-8-sig\")\n",
+    "    data = data.dropna(how=\"all\").copy()\n",
+    "    data.columns = data.columns.str.strip()\n",
+    "    data = data.loc[:, ~data.columns.str.startswith(\"Unnamed:\")]\n",
+    "    if data.empty:\n",
+    "        raise ValueError(\"CSV tidak memuat baris observasi.\")\n",
+    "    if data.columns.duplicated().any():\n",
+    "        raise ValueError(\"Nama kolom harus unik.\")\n",
+    "    if {\"Date\", \"Time\"} <= set(data.columns):\n",
+    "        dates = data.pop(\"Date\").astype(str) + \" \" + data.pop(\"Time\").astype(str)\n",
+    "        times = pd.to_datetime(dates, format=\"%d/%m/%Y %H.%M.%S\", errors=\"coerce\")\n",
+    "    else:\n",
+    "        key = next((k for k in [\"timestamp\", \"Date_Time\"] if k in data), None)\n",
+    "        if key is None:\n",
+    "            raise ValueError(\"Sertakan timestamp ISO, atau pasangan Date dan Time seperti pada CSV UCI.\")\n",
+    "        times = pd.to_datetime(data.pop(key), format=\"ISO8601\", errors=\"coerce\")\n",
+    "    if times.isna().any() or times.duplicated().any():\n",
+    "        raise ValueError(\"Ada waktu kosong, tidak valid, atau duplikat.\")\n",
+    "    if not times.dt.floor(\"h\").equals(times):\n",
+    "        raise ValueError(\"Setiap waktu observasi harus tepat pada jam penuh.\")\n",
+    "    absent = [name for name in required if name not in data]\n",
+    "    if absent:\n",
+    "        raise ValueError(\"Kolom wajib belum ada: \" + \", \".join(absent))\n",
+    "    values = data.apply(numbers)\n",
+    "    values.index = pd.DatetimeIndex(times, name=\"timestamp\")\n",
+    "    values = values.sort_index()\n",
+    "    if require_contiguous and not values.index.to_series().diff().dropna().eq(pd.Timedelta(hours=1)).all():\n",
+    "        raise ValueError(\"Riwayat harus berurutan per jam. Isi jam yang hilang sebagai baris kosong beserta timestamp.\")\n",
+    "    return values\n",
+    "\n",
+    "\n",
+    "def fit_transform(frame, end_train):\n",
+    "    training = frame.iloc[:end_train]\n",
+    "    x = training[FEATURES]\n",
+    "    med = x.median()\n",
+    "    if med.isna().any() or training[TARGET].dropna().empty:\n",
+    "        raise ValueError(\"Data latih tidak cukup untuk menghitung parameter.\")\n",
+    "    filled = x.fillna(med)\n",
+    "    y = training[TARGET].dropna()\n",
+    "    return {\"features\": FEATURES, \"median\": med.tolist(), \"mean\": filled.mean().tolist(),\n",
+    "            \"std\": filled.std(ddof=0).replace(0, 1).tolist(), \"y_mean\": float(y.mean()),\n",
+    "            \"y_std\": float(y.std(ddof=0)) or 1.0}\n",
+    "\n",
+    "\n",
+    "def standardize(frame, columns, prep):\n",
+    "    ids = [prep[\"features\"].index(c) for c in columns]\n",
+    "    raw = frame[columns].to_numpy(dtype=float)\n",
+    "    filled = np.where(np.isnan(raw), np.asarray(prep[\"median\"])[ids], raw)\n",
+    "    return ((filled - np.asarray(prep[\"mean\"])[ids]) / np.asarray(prep[\"std\"])[ids]).astype(\"float32\")\n",
+    "\n",
+    "\n",
+    "def make_windows(arr, length):\n",
+    "    return np.lib.stride_tricks.sliding_window_view(arr, length, axis=0).swapaxes(1, 2)\n",
+    "\n",
+    "\n",
+    "def prepare(frame):\n",
+    "    n = len(frame)\n",
+    "    a, b = int(n * .70), int(n * .85)\n",
+    "    prep = fit_transform(frame, a)\n",
+    "    x = standardize(frame, FEATURES, prep)\n",
+    "    target = frame[TARGET].to_numpy()\n",
+    "    # A target at i only sees inputs through i-1. Every model uses the same target times.\n",
+    "    anchors = np.arange(MAX_STEPS, n)\n",
+    "    present = make_windows(frame[FEATURES].notna().to_numpy(), MIN_STEPS)\n",
+    "    usable = present[anchors - MIN_STEPS].any(axis=1).all(axis=1)\n",
+    "    anchors = anchors[usable & np.isfinite(target[anchors])]\n",
+    "    splits = {\"train\": anchors[anchors < a], \"val\": anchors[(anchors >= a) & (anchors < b)],\n",
+    "              \"test\": anchors[anchors >= b]}\n",
+    "    if any(len(part) < 2 for part in splits.values()):\n",
+    "        raise ValueError(\"Setiap partisi memerlukan sedikitnya dua target CO dengan riwayat sensor.\")\n",
+    "    return prep, x, target, splits, (a, b)\n",
+    "''', encoding='utf-8')\n",
+    "print('air_data.py siap.')"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "id": "00d4f63a",
+   "metadata": {},
+   "source": [
+    "### recurrent.py"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "e5503f5a",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "(work / 'recurrent.py').write_text(r'''\"\"\"Elman RNN with backpropagation through time, Adam, and portable NumPy weights.\"\"\"\n",
+    "import numpy as np\n",
+    "\n",
+    "BASE = {\"length\": 6, \"units\": 12, \"lr\": .003, \"dropout\": .10}\n",
+    "\n",
+    "\n",
+    "def init_params(n_features, hidden, rng):\n",
+    "    def weight(a, b):\n",
+    "        lim = np.sqrt(6 / (a + b))\n",
+    "        return rng.uniform(-lim, lim, (a, b)).astype(\"float32\")\n",
+    "    return {\"wx\": weight(n_features, hidden), \"wh\": weight(hidden, hidden) * .65,\n",
+    "            \"bh\": np.zeros(hidden, \"float32\"), \"wy\": weight(hidden, 1).ravel(),\n",
+    "            \"by\": np.zeros(1, \"float32\")}\n",
+    "\n",
+    "\n",
+    "def hidden_states(x, p):\n",
+    "    states = [np.zeros((len(x), len(p[\"bh\"])), dtype=\"float32\")]\n",
+    "    for step in x.transpose(1, 0, 2):\n",
+    "        states.append(np.tanh(step @ p[\"wx\"] + states[-1] @ p[\"wh\"] + p[\"bh\"]))\n",
+    "    return states\n",
+    "\n",
+    "\n",
+    "def predict(x, p):\n",
+    "    return hidden_states(x, p)[-1] @ p[\"wy\"] + p[\"by\"]\n",
+    "\n",
+    "\n",
+    "def fit(x, y, vx, vy, config, seed, epochs, patience):\n",
+    "    rng = np.random.default_rng(seed)\n",
+    "    p = init_params(x.shape[-1], config[\"units\"], rng)\n",
+    "    m, v = ({key: np.zeros_like(val) for key, val in p.items()} for _ in range(2))\n",
+    "    history, best, best_loss = [], {}, np.inf\n",
+    "    step = stale = 0\n",
+    "    for epoch in range(1, epochs + 1):\n",
+    "        order = rng.permutation(len(x))\n",
+    "        for start in range(0, len(order), 128):\n",
+    "            ids = order[start:start + 128]\n",
+    "            batch = x[ids]\n",
+    "            states = hidden_states(batch, p)\n",
+    "            keep = 1 - config[\"dropout\"]\n",
+    "            mask = (rng.random(states[-1].shape) < keep).astype(\"float32\") / keep\n",
+    "            output = states[-1] * mask\n",
+    "            error = (2 / len(ids)) * (output @ p[\"wy\"] + p[\"by\"] - y[ids])\n",
+    "            grads = {\"wy\": output.T @ error, \"by\": np.atleast_1d(error.sum()),\n",
+    "                     \"wx\": np.zeros_like(p[\"wx\"]), \"wh\": np.zeros_like(p[\"wh\"]),\n",
+    "                     \"bh\": np.zeros_like(p[\"bh\"])}\n",
+    "            dh = error[:, None] * p[\"wy\"] * mask\n",
+    "            for t in reversed(range(batch.shape[1])):\n",
+    "                dz = dh * (1 - states[t + 1] ** 2)\n",
+    "                grads[\"wx\"] += batch[:, t].T @ dz\n",
+    "                grads[\"wh\"] += states[t].T @ dz\n",
+    "                grads[\"bh\"] += dz.sum(axis=0)\n",
+    "                dh = dz @ p[\"wh\"].T\n",
+    "            step += 1\n",
+    "            for key, grad in grads.items():\n",
+    "                grad = np.clip(grad, -5., 5.)\n",
+    "                m[key] = .9 * m[key] + .1 * grad\n",
+    "                v[key] = .999 * v[key] + .001 * grad ** 2\n",
+    "                p[key] -= config[\"lr\"] * (m[key] / (1 - .9 ** step)) / (np.sqrt(v[key] / (1 - .999 ** step)) + 1e-8)\n",
+    "        loss = float(np.mean((predict(x, p) - y) ** 2))\n",
+    "        val_loss = float(np.mean((predict(vx, p) - vy) ** 2))\n",
+    "        history.append({\"epoch\": epoch, \"train_mse_z\": loss, \"val_mse_z\": val_loss})\n",
+    "        if val_loss < best_loss:\n",
+    "            best_loss, stale = val_loss, 0\n",
+    "            best = {k: a.copy() for k, a in p.items()}\n",
+    "            best_epoch = epoch\n",
+    "        else:\n",
+    "            stale += 1\n",
+    "            if stale >= patience:\n",
+    "                break\n",
+    "    return best, history, best_epoch\n",
+    "''', encoding='utf-8')\n",
+    "print('recurrent.py siap.')"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "id": "cb3543ca",
+   "metadata": {},
+   "source": [
+    "### optimize.py"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "009c1e0b",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "(work / 'optimize.py').write_text(r'''\"\"\"Validation-only evolutionary searches. One search per seed with cumulative logs.\"\"\"\n",
+    "import numpy as np\n",
+    "\n",
+    "from air_data import FEATURES\n",
+    "from recurrent import BASE\n",
+    "\n",
+    "POP, GENERATIONS = 6, 5\n",
+    "PARTICLES, ROUNDS = 5, 5\n",
+    "SEEDS = (7, 19, 42)\n",
+    "PENALTY = .03\n",
+    "LENGTHS, UNITS = (4, 6, 8), (8, 12, 16, 20, 24)\n",
+    "\n",
+    "\n",
+    "def genetic(score, seed):\n",
+    "    rng = np.random.default_rng(seed)\n",
+    "    n = len(FEATURES)\n",
+    "    pop = rng.integers(0, 2, (POP, n)).astype(bool)\n",
+    "    pop[0] = True\n",
+    "    history, records = [], []\n",
+    "    for gen in range(1, GENERATIONS + 1):\n",
+    "        for mask in pop:\n",
+    "            if not mask.any():\n",
+    "                mask[rng.integers(n)] = True\n",
+    "        fitness = []\n",
+    "        for mask in pop:\n",
+    "            error = score(tuple(np.flatnonzero(mask)), BASE)\n",
+    "            cost = error + PENALTY * mask.sum() / n\n",
+    "            fitness.append(cost)\n",
+    "            records.append({\"generation\": gen, \"bits\": \"\".join(map(str, mask.astype(int))),\n",
+    "                            \"val_rmse\": error, \"fitness\": float(cost)})\n",
+    "        elite = pop[np.argmin(fitness)].copy()\n",
+    "        history.append(float(min(fitness)))\n",
+    "        new = [elite]\n",
+    "        def tournament():\n",
+    "            ids = rng.choice(POP, size=3, replace=False)\n",
+    "            return pop[ids[np.argmin(np.asarray(fitness)[ids])]]\n",
+    "        while len(new) < POP:\n",
+    "            left, right = tournament(), tournament()\n",
+    "            child = left.copy()\n",
+    "            if rng.random() < .8:\n",
+    "                cut = rng.integers(1, n)\n",
+    "                child[cut:] = right[cut:]\n",
+    "            child ^= rng.random(n) < 1 / n\n",
+    "            new.append(child)\n",
+    "        pop = np.asarray(new)\n",
+    "    return {\"seed\": seed, \"features\": [FEATURES[i] for i in np.flatnonzero(elite)],\n",
+    "            \"fitness\": history[-1], \"history\": history, \"candidates\": records}\n",
+    "\n",
+    "\n",
+    "def decode(position):\n",
+    "    length, units, rate, drop = position\n",
+    "    return {\"length\": LENGTHS[round(float(length) * (len(LENGTHS) - 1))],\n",
+    "            \"units\": UNITS[round(float(units) * (len(UNITS) - 1))],\n",
+    "            \"lr\": round(float(10 ** (-3 + rate)), 5), \"dropout\": round(.25 * float(drop), 2)}\n",
+    "\n",
+    "\n",
+    "def swarm(score, indices, seed):\n",
+    "    rng = np.random.default_rng(seed)\n",
+    "    pos = rng.random((PARTICLES, 4))\n",
+    "    vel = rng.uniform(-.15, .15, size=pos.shape)\n",
+    "    pbest, p_cost = pos.copy(), np.full(PARTICLES, np.inf)\n",
+    "    history, records = [], []\n",
+    "    for iteration in range(1, ROUNDS + 1):\n",
+    "        for i, particle in enumerate(pos):\n",
+    "            params = decode(particle)\n",
+    "            cost = score(indices, params)\n",
+    "            records.append({\"iteration\": iteration, \"particle\": i + 1, \"params\": params,\n",
+    "                            \"position\": particle.tolist(), \"val_rmse\": cost})\n",
+    "            if cost < p_cost[i]:\n",
+    "                p_cost[i], pbest[i] = cost, particle.copy()\n",
+    "        best = pbest[np.argmin(p_cost)].copy()\n",
+    "        history.append(float(np.min(p_cost)))\n",
+    "        r1, r2 = rng.random(pos.shape), rng.random(pos.shape)\n",
+    "        vel = np.clip(.65 * vel + 1.4 * r1 * (pbest - pos) + 1.4 * r2 * (best - pos), -.35, .35)\n",
+    "        pos = np.clip(pos + vel, 0, 1)\n",
+    "    return {\"seed\": seed, \"parameters\": decode(best), \"fitness\": history[-1],\n",
+    "            \"history\": history, \"candidates\": records}\n",
+    "''', encoding='utf-8')\n",
+    "print('optimize.py siap.')"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "id": "0e04473b",
